# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pocika?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# One-time Seed Admin Credentials (used by scripts/seedAdmin.js)
ADMIN_NAME="Pocika Admin"
ADMIN_EMAIL=admin@pocika.com
ADMIN_PASSWORD=change_this_strong_password_in_env

# Cloudinary Configuration (Server-side product image storage - folder: pocika/quotation-products)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
